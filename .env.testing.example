# ============================================================
# .env.testing.example — LawFirm CRM — Ambiente de Testes
# ============================================================
#
# INSTRUÇÕES DE USO:
#   1. Copie este arquivo: cp .env.testing.example .env.testing
#   2. Gere uma APP_KEY válida: php artisan key:generate --env=testing
#   3. NÃO use este arquivo diretamente como .env.testing em produção.
#
# ISOLAMENTO: Todos os bancos de dados terminam em _test.
# Nenhuma conexão aponta para produção.
# ============================================================

APP_NAME="LawFirm CRM (Testing)"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://app-tenant-a.test
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_CURRENCY=BRL

# ─── SENTINEL DE SEGURANÇA ─────────────────────────────────
# Este valor é OBRIGATÓRIO. O DatabaseSafetyGuard aborta com
# RuntimeException se estiver ausente ou com valor diferente.
TEST_ENVIRONMENT_ACK=LAW_FIRM_ISOLATED_TEST

# ─── TENANT DE TESTE ───────────────────────────────────────
TENANT_ID=tenant_a

# ─── BANCO: TENANT A ───────────────────────────────────────
DB_CONNECTION=tenant_a
DB_TEST_TENANT_A_HOST=mysql-test
DB_TEST_TENANT_A_PORT=3306
DB_TEST_TENANT_A_DATABASE=tenant_a_test
DB_TEST_TENANT_A_USERNAME=test_user
DB_TEST_TENANT_A_PASSWORD=test_password

# ─── BANCO: TENANT B ───────────────────────────────────────
DB_TEST_TENANT_B_HOST=mysql-test
DB_TEST_TENANT_B_PORT=3306
DB_TEST_TENANT_B_DATABASE=tenant_b_test
DB_TEST_TENANT_B_USERNAME=test_user
DB_TEST_TENANT_B_PASSWORD=test_password

# ─── BANCO: MOTHERSHIP ─────────────────────────────────────
DB_TEST_MOTHERSHIP_HOST=mothership-db-test
DB_TEST_MOTHERSHIP_PORT=3306
DB_TEST_MOTHERSHIP_DATABASE=mothership_test
DB_TEST_MOTHERSHIP_USERNAME=test_user
DB_TEST_MOTHERSHIP_PASSWORD=test_password

# ─── REDIS (ISOLADO POR PREFIXO) ───────────────────────────
REDIS_HOST=redis-test
REDIS_PORT=6379
REDIS_PREFIX=tenant_a_test_
REDIS_PASSWORD=null

# ─── DRIVERS DE CACHE / SESSÃO ─────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# ─── TESTES DE IA ──────────────────────────────────────────
# Manter false: testes de IA são mockados, nunca chamam produção.
AI_REAL_TESTS=false

# ─── EMAIL ─────────────────────────────────────────────────
MAIL_MAILER=array

# ─── BCRYPT ────────────────────────────────────────────────
BCRYPT_ROUNDS=4
